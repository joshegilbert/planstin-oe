# Copy to .env.local and fill in from your Supabase project
# (Supabase dashboard -> Project Settings -> API)
#
# Leave BOTH of these unset to run the app against built-in demo data.
# When they are unset the app shows a "Demo data" banner and every edit is
# kept in browser localStorage only.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
